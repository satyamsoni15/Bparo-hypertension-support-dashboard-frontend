# Copy to .env.local and fill in real values. Never commit .env.local.

# Support backend (Bparo-hypertension-support-dashboard-backend), server-side only.
SUPPORT_API_URL="http://localhost:4300/api/v1"

# Auth.js (NextAuth v5). Generate the secret with `npx auth secret`.
AUTH_SECRET=""
AUTH_URL="http://localhost:3007"
AUTH_TRUST_HOST=true
